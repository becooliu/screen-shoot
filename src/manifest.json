{
  "manifest_version": 3,
  "name": "Chrome coordinate Capture",
  "version": "1.0",
  "description": "use coordinate to capture specified area",
  "permissions": ["activeTab", "scripting", "downloads", "storage"],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "action": {},
  "icons": {
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "content/panel-template.html",
        "content/panel-component.js",
        "content/content-script.js"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
